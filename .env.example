# =============================================================
# RealtorDesk AI - Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# ── Supabase (Frontend) ──────────────────────────────────────
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-anon-public-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# ── Sentry (Error Monitoring) ────────────────────────────────
# Optional — Sentry only initialises when this is set AND running in production
VITE_SENTRY_DSN=""

# ── Storage Buckets ──────────────────────────────────────────
VITE_CAREERS_RESUME_BUCKET="career-resumes"

# ── Community ────────────────────────────────────────────────
# Discord (or other) invite URL for the Realtor Desk community.
# When unset, all community surfaces (dashboard banner, nav link,
# footer link, blog post link) hide themselves so we never ship
# a broken "Join community" button. Set to e.g.
# https://discord.gg/realtordesk-community when the server is live.
VITE_COMMUNITY_URL=""

# =============================================================
# Supabase Edge Function Secrets
# Set these in your Supabase project dashboard under
# Project Settings → Edge Functions → Secrets
# (NOT in this file — they are server-side only)
# =============================================================

# ── Supabase (Server-side) ───────────────────────────────────
# SUPABASE_URL              → auto-provided by Supabase runtime
# SUPABASE_ANON_KEY         → auto-provided by Supabase runtime
# SUPABASE_SERVICE_ROLE_KEY → set in Supabase secrets

# ── Stripe ───────────────────────────────────────────────────
# STRIPE_SECRET_KEY         → sk_live_... or sk_test_...
# STRIPE_WEBHOOK_SECRET     → whsec_... (from Stripe webhook dashboard)

# ── Claude / AI ──────────────────────────────────────────────
# LOVABLE_API_KEY           → Anthropic/Claude API key used by ai-chatbot & claude-chat functions

# ── OpenAI ───────────────────────────────────────────────────
# OPENAI_API_KEY            → Used by generate-call-summary function

# ── Resend (Transactional Email) ─────────────────────────────
# RESEND_API_KEY            → re_... (from resend.com)

# ── Twilio (SMS) ─────────────────────────────────────────────
# TWILIO_ACCOUNT_SID        → ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN         → your Twilio auth token
# TWILIO_PHONE_NUMBER       → +1XXXXXXXXXX (your Twilio number)

# ── Apify (Web Scraping) ─────────────────────────────────────
# APIFY_TOKEN               → your Apify API token

# ── Encryption ───────────────────────────────────────────────
# ENCRYPTION_KEY            → 32-byte hex key for OAuth token encryption
#                             Generate: openssl rand -hex 32

# ── Stripe price / product IDs ────────────────────────────────────────────────
# Test-mode and live-mode IDs differ. Set these per environment in Vercel so
# switching modes is config, not a deploy. Missing values fail loudly at
# checkout rather than silently falling back.
# Values below are the TEST-mode catalogue.
VITE_STRIPE_PRICE_SOLO_MONTHLY=price_1TyCKNLZmtn1y8Y2EiZmGPQm
VITE_STRIPE_PRICE_SOLO_YEARLY=price_1TyCLVLZmtn1y8Y2gbJkdGGx
VITE_STRIPE_PRICE_TEAM_MONTHLY=price_1TyCMkLZmtn1y8Y2Xci7MMVU
VITE_STRIPE_PRICE_TEAM_YEARLY=price_1TyCNeLZmtn1y8Y2QdQUwCiO
VITE_STRIPE_PRODUCT_SOLO=prod_Uy8byeGOcAUeFh
VITE_STRIPE_PRODUCT_TEAM=prod_Uy8epHTUzrvBbK
# The create-checkout edge function needs the same four price IDs as Supabase
# secrets (without the VITE_ prefix): STRIPE_PRICE_SOLO_MONTHLY, etc.
