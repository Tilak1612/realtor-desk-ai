<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        The app is light-only: the web UI never follows the system dark setting. So
        nothing native may follow it either, or a phone in dark mode opens the app on
        a near-black screen. Three things keep the launch on the app's paper colour
        (#FAFAF7, the same value as backgroundColor in capacitor.config.ts):
          - the activity theme is a Light theme, not DayNight;
          - its window background is the paper colour, so the moment between the
            splash going away and the web view's first frame is not a dark window;
          - the Android 12+ system splash is given the paper colour explicitly. Its
            default is ?android:colorBackground, which is near-black in dark mode.
        There are no drawable-night splash images for the same reason. See
        scripts/generate-mobile-assets.mjs.
    -->
    <color name="paper">#FAFAF7</color>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/paper</item>
        <!-- Dark status bar icons: the splash is light whatever the system appearance. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>