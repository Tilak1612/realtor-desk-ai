<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing the app stores is backed up or transferred to a new device. The
     sign-in session is encrypted with a key that never leaves this device's
     keystore, so a restored copy could not be read anyway; excluding it means a
     new phone starts signed out instead of holding an unreadable blob. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
